#!/bin/bash
# Pre-commit hook to detect hardcoded credentials
# 하드코딩된 API 키를 감지하여 커밋을 방지합니다

echo "🔍 하드코딩된 인증 정보 검사 중..."

# Python이 설치되어 있는지 확인
if ! command -v python3 &> /dev/null && ! command -v python &> /dev/null; then
    echo "⚠️  Python이 설치되어 있지 않습니다. 검사를 건너뜁니다."
    exit 0
fi

# Python 명령어 설정
PYTHON_CMD="python3"
if ! command -v python3 &> /dev/null; then
    PYTHON_CMD="python"
fi

# 임시 Python 스크립트 생성
cat > /tmp/check_secrets.py << 'PYTHON_SCRIPT'
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""하드코딩된 인증 정보 검사"""

import re
import sys
import subprocess

def get_staged_files():
    """스테이징된 파일 목록 가져오기"""
    try:
        result = subprocess.run(
            ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACM'],
            capture_output=True,
            text=True,
            check=True
        )
        return result.stdout.strip().split('\n') if result.stdout.strip() else []
    except subprocess.CalledProcessError:
        return []

def check_file_for_secrets(file_path):
    """파일에서 하드코딩된 인증 정보 검사"""
    # 바이너리 파일이나 특정 파일은 건너뛰기
    skip_extensions = ['.pyc', '.so', '.dll', '.exe', '.jpg', '.png', '.gif', '.pdf', '.xlsx', '.csv']
    skip_files = ['.env.template', 'pre-commit', 'check_secrets.py']

    if any(file_path.endswith(ext) for ext in skip_extensions):
        return []

    if any(skip_file in file_path for skip_file in skip_files):
        return []

    issues = []

    # 의심스러운 패턴들
    patterns = [
        (r'api[_-]?key\s*[=:]\s*["\']([a-zA-Z0-9_\-\.]{20,})["\']', 'API Key'),
        (r'secret[_-]?key\s*[=:]\s*["\']([a-zA-Z0-9_\-\.]{20,})["\']', 'Secret Key'),
        (r'access[_-]?token\s*[=:]\s*["\']([a-zA-Z0-9_\-\.]{20,})["\']', 'Access Token'),
        (r'client[_-]?secret\s*[=:]\s*["\']([a-zA-Z0-9_\-\.]{20,})["\']', 'Client Secret'),
        (r'password\s*[=:]\s*["\']([^"\']{8,})["\']', 'Password'),
        (r'[a-f0-9]{32}\.[\w]{10,}', 'API Key Pattern'),
        (r'sk-[a-zA-Z0-9]{32,}', 'OpenAI Key'),
        (r'ghp_[a-zA-Z0-9]{36}', 'GitHub Personal Access Token'),
        (r'AIza[a-zA-Z0-9_\-]{35}', 'Google API Key'),
        (r'AKIA[A-Z0-9]{16}', 'AWS Access Key'),
    ]

    # 플레이스홀더 패턴 (이것들은 괜찮음)
    placeholders = [
        'your_', 'YOUR_', 'replace_', 'REPLACE_',
        'example', 'EXAMPLE', 'placeholder', 'PLACEHOLDER',
        'xxx', 'XXX', 'yyy', 'YYY', 'zzz', 'ZZZ',
        'changeme', 'CHANGEME', 'todo', 'TODO',
        '12345', 'test', 'TEST', 'demo', 'DEMO',
        'sample', 'SAMPLE'
    ]

    # "나쁜 예시" 문맥 패턴 (문서에서 보여주는 잘못된 예시)
    bad_example_patterns = [
        '❌', '절대', '하지 마', '나쁜 예', 'bad example',
        'do not', "don't", '금지', 'wrong', 'incorrect'
    ]

    try:
        with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
            lines = f.readlines()

            for line_num, line in enumerate(lines, 1):
                line_stripped = line.strip()

                # 주석은 건너뛰기
                if line_stripped.startswith('#') or line_stripped.startswith('//'):
                    continue

                # 문서의 나쁜 예시 섹션 확인 (현재 라인과 이전 몇 줄 확인)
                context_lines = []
                for i in range(max(0, line_num - 3), line_num):
                    if i < len(lines):
                        context_lines.append(lines[i])
                context = ''.join(context_lines)

                is_bad_example_section = any(pattern in context for pattern in bad_example_patterns)

                for pattern, name in patterns:
                    matches = re.finditer(pattern, line, re.IGNORECASE)
                    for match in matches:
                        matched_text = match.group(0)

                        # 플레이스홀더는 제외
                        is_placeholder = any(ph in matched_text for ph in placeholders)

                        # 나쁜 예시 섹션의 내용은 제외
                        if not is_placeholder and not is_bad_example_section:
                            issues.append({
                                'file': file_path,
                                'line': line_num,
                                'type': name,
                                'text': matched_text[:50] + '...' if len(matched_text) > 50 else matched_text
                            })

    except Exception as e:
        print(f"⚠️  파일 읽기 오류 ({file_path}): {e}", file=sys.stderr)

    return issues

def main():
    """메인 함수"""
    staged_files = get_staged_files()

    if not staged_files:
        print("✅ 스테이징된 파일이 없습니다.")
        return 0

    print(f"📝 {len(staged_files)}개 파일 검사 중...")

    all_issues = []
    for file_path in staged_files:
        if not file_path.strip():
            continue
        issues = check_file_for_secrets(file_path)
        all_issues.extend(issues)

    if all_issues:
        print("\n" + "="*70)
        print("🚨 하드코딩된 인증 정보가 발견되었습니다!")
        print("="*70)

        for issue in all_issues:
            print(f"\n파일: {issue['file']}")
            print(f"라인: {issue['line']}")
            print(f"타입: {issue['type']}")
            print(f"내용: {issue['text']}")

        print("\n" + "="*70)
        print("❌ 커밋이 차단되었습니다!")
        print("\n💡 해결 방법:")
        print("1. 하드코딩된 API 키를 환경 변수로 변경하세요")
        print("2. .env 파일에 실제 값을 저장하세요")
        print("3. 코드에서는 config_loader를 사용하여 로드하세요")
        print("\n자세한 내용은 SECURITY_GUIDE.md를 참조하세요")
        print("="*70 + "\n")

        return 1

    print("✅ 하드코딩된 인증 정보가 발견되지 않았습니다!")
    return 0

if __name__ == "__main__":
    sys.exit(main())
PYTHON_SCRIPT

# Python 스크립트 실행
$PYTHON_CMD /tmp/check_secrets.py
EXIT_CODE=$?

# 임시 파일 정리
rm -f /tmp/check_secrets.py

# 결과에 따라 종료
if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "💡 Tip: 의도적으로 커밋하려면 --no-verify 옵션을 사용할 수 있습니다"
    echo "   (하지만 보안상 권장하지 않습니다!)"
    exit 1
fi

exit 0
