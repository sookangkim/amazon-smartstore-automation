# 개인용 GitHub 토큰 (각자 다름)
GITHUB_TOKEN=각자_생성한_토큰
GITHUB_USERNAME=your_github_username
GITHUB_EMAIL=your_github_email@example.com

# sookangkim 계정 아마존 프로젝트 저장소 (모두 동일)
GITHUB_REPO=sookangkim/amazon-smartstore-automation
GITHUB_REPO_URL=https://github.com/sookangkim/amazon-smartstore-automation.git

# 공통 Slack 설정 (모두 동일) - 기존 웹훅 사용
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/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
SLACK_CHANNEL=#general
SLACK_USERNAME=Amazon-Automation-Bot

# 팀 정보 - 기존 팀에 아마존 프로젝트 추가
TEAM_NAME=Unmanned_Team
PROJECT_NAME=Amazon_Smartstore_Module

# 개발 환경 설정
DEVELOPMENT_MODE=true
DEBUG_MODE=false
LOG_LEVEL=INFO

# 네이버 스마트스토어 API 인증 정보 (각자 발급받아 입력)
# 네이버 커머스 API: https://commerce.naver.com/
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
NAVER_CUSTOMER_ID=your_naver_customer_id_here

# 네이버 스마트스토어 자동화 설정
AUTO_REGISTER=false
MAX_DAILY_REGISTRATIONS=100
PROFIT_MARGIN_THRESHOLD=30

# 아마존 API (선택사항 - 공식 API 사용 시)
AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here
AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag_here

# 번역 API (선택사항 - Papago 등)
TRANSLATION_API_KEY=your_translation_api_key_here

# 보안 주의사항:
# 1. 절대로 실제 API 키를 git에 커밋하지 마세요
# 2. .env 파일은 .gitignore에 포함되어 있습니다
# 3. 팀원과 API 키를 공유할 때는 안전한 채널을 사용하세요